{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/admin.html", "destination": "/admin", "permanent": true }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
